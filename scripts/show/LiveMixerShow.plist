<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent template for the LiveMixer show: starts scripts/show/show.sh at login and restarts it if it ever exits.
  Do not load this file directly: scripts/show/install-launch-agent.sh fills in __ROOT__ and __HOME__ and installs it
  as ~/Library/LaunchAgents/com.livemixer.show.plist.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.livemixer.show</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__ROOT__/scripts/show/show.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__ROOT__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:__HOME__/.local/bin:__HOME__/.cargo/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <!-- Show settings (see the top of show.sh), for example:
    <key>LIVEMIXER_SIM</key><string>tide</string>
    <key>LIVEMIXER_SIM_POSITION</key><string>1920,0</string>
    -->
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- Wait this long before starting it again after it exits, so a broken setup does not spin. -->
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <!-- Time for show.sh to stop its services (and the bridge to release Live) before launchd kills it. -->
  <key>ExitTimeOut</key>
  <integer>30</integer>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>__ROOT__/logs/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__ROOT__/logs/launchd.log</string>
</dict>
</plist>
